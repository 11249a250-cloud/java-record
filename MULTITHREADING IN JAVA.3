class PaymentProcess implements Runnable {
    @Override
    public void run() {
        for (int i = 1; i <= 5; i++) {
            System.out.println("Payment Processing... (" + i + "/5)");
            try {
                Thread.sleep(400); // Small pause for simulation
            } catch (InterruptedException e) {
                System.out.println("Payment process interrupted.");
            }
        }
        System.out.println("Payment Completed Successfully!");
    }
}

public class PaymentGatewayApp {
    public static void main(String[] args) {
        PaymentProcess paymentTask = new PaymentProcess();
        Thread paymentThread = new Thread(paymentTask);
        
        paymentThread.start();
    }
}

