import java.applet.Applet;
import java.awt.*;

/*
<applet code="HouseApplet" width="400" height="400">
</applet>
*/
public class HouseApplet extends Applet {
    @Override
    public void paint(Graphics g) {
        // House Base (Rectangle)
        g.setColor(Color.LIGHT_GRAY);
        g.fillRect(120, 180, 160, 150);
        g.setColor(Color.BLACK);
        g.drawRect(120, 180, 160, 150);

        // Roof (Triangle using polygon)
        int[] xPoints = {200, 100, 300};
        int[] yPoints = {100, 180, 180};
        g.setColor(Color.RED);
        g.fillPolygon(xPoints, yPoints, 3);
        g.setColor(Color.BLACK);
        g.drawPolygon(xPoints, yPoints, 3);

        // Door
        g.setColor(Color.ORANGE);
        g.fillRect(175, 250, 50, 80);
        g.setColor(Color.BLACK);
        g.drawRect(175, 250, 50, 80);

        // Windows
        g.setColor(Color.CYAN);
        g.fillRect(140, 200, 35, 35);
        g.fillRect(225, 200, 35, 35);
        g.setColor(Color.BLACK);
        g.drawRect(140, 200, 35, 35);
        g.drawRect(225, 200, 35, 35);
    }
}

OUTPUT:

Renders a house structure complete with a red triangular roof, grey body, orange door, and two cyan windows.
