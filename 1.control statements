public class ControlStatementsDemo {
    public static void main(String[] args) {
        // --- Selection Statements ---
        int score = 85;

        // a) if statement
        if (score > 50) {
            System.out.println("Passed the exam (if statement)");
        }

        // b) if-else statement
        if (score >= 90) {
            System.out.println("Grade: A");
        } else {
            System.out.println("Grade: Below A (if-else statement)");
        }

        // c) switch statement
        int day = 3;
        switch (day) {
            case 1:
                System.out.println("Monday");
                break;
            case 2:
                System.out.println("Tuesday");
                break;
            case 3:
                System.out.println("Wednesday (switch statement)");
                break;
            default:
                System.out.println("Other day");
        }

        // --- Looping Statements ---
        // a) for loop
        System.out.print("For loop: ");
        for (int i = 1; i <= 3; i++) {
            System.out.print(i + " ");
        }
        System.out.println();

        // b) while loop
        System.out.print("While loop: ");
        int w = 1;
        while (w <= 3) {
            System.out.print(w + " ");
            w++;
        }
        System.out.println();

        // c) do-while loop
        System.out.print("Do-While loop: ");
        int d = 1;
        do {
            System.out.print(d + " ");
            d++;
        } while (d <= 3);
        System.out.println();
    }
}

